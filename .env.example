# Konfigurasi publik aplikasi web Firebase dari Project Settings > Your apps.
# Ini bukan Admin SDK atau service-account private key.
# Salin ke .env.local (tidak masuk Git), lalu isi nilai project milikmu.
# Empat nilai ini wajib; projectId saja belum mengaktifkan Google Login.
# Pada Vercel, isi di Settings > Environment Variables dan Redeploy setelah disimpan.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Dua nilai berikut opsional; tidak digunakan untuk lampiran saat ini.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# AI opsional: tetap false sampai Free Tier model dan Spark diverifikasi di Console.
# Tidak ada model default: isi model ringan yang masih tersedia gratis saat aktivasi.
# Tidak memakai Gemini API key. App Check memakai public reCAPTCHA v3 site key.
VITE_FIREBASE_AI_ENABLED=false
VITE_FIREBASE_AI_FREE_TIER_CONFIRMED=false
VITE_FIREBASE_AI_MODEL=
VITE_FIREBASE_APP_CHECK_SITE_KEY=
